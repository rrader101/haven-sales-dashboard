SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_INSTANCE_URL=YOUR_INSTANCE_URL_HERE
SALESFORCE_CLIENT_ID=YOUR_CONNECTED_APP_CONSUMER_KEY
SALESFORCE_CLIENT_SECRET=YOUR_CONNECTED_APP_CONSUMER_SECRET
SALESFORCE_REFRESH_TOKEN=YOUR_LONG_LIVED_REFRESH_TOKEN

# Analytics report IDs (from the Reports URL in Salesforce)
SALESFORCE_REPORT_ID_WEEKLY=00OXXXXXXXXXXXXXXX
SALESFORCE_REPORT_ID_DAILY=00OYYYYYYYYYYYYYYY

# Optional: override API version if needed
SALESFORCE_API_VERSION=v59.0

